{
  "name": "react-native-skeleton-native",
  "version": "0.1.0",
  "description": "Skeleton and shimmer placeholders for React Native whose animation runs on the platform compositor (Core Animation on iOS, RenderThread on Android), so it keeps moving while the JS thread and the UI thread are busy. Old and New Architecture.",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "author": "Moksh Upadhyay <mokshupadhyay4@gmail.com>",
  "homepage": "https://github.com/mokshupadhyay/react-native-skeleton-native#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mokshupadhyay/react-native-skeleton-native.git"
  },
  "bugs": {
    "url": "https://github.com/mokshupadhyay/react-native-skeleton-native/issues"
  },
  "files": [
    "src",
    "lib",
    "android/build.gradle",
    "android/src",
    "ios",
    "react-native-skeleton-native.podspec",
    "react-native.config.js",
    "!**/__tests__",
    "!**/*.test.ts",
    "!**/*.test.tsx",
    "!**/*.map"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "check": "npm run typecheck && npm test && npm run build",
    "example:install": "npm pack --pack-destination example && cd example && npm install ./react-native-skeleton-native-$npm_package_version.tgz",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "keywords": [
    "react-native",
    "skeleton",
    "shimmer",
    "placeholder",
    "loading",
    "content-loader",
    "core-animation",
    "renderthread",
    "fabric",
    "new-architecture"
  ],
  "license": "MIT",
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-native": ">=0.71.0"
  },
  "codegenConfig": {
    "name": "RNSkeletonNativeSpec",
    "type": "components",
    "jsSrcsDir": "src/specs",
    "android": {
      "javaPackageName": "com.skeletonnative"
    },
    "ios": {
      "componentProvider": {
        "SkeletonNativeView": "RNSkeletonNativeComponentView",
        "SkeletonNativeGroup": "RNSkeletonGroupComponentView",
        "SkeletonNativeShimmer": "RNSkeletonShimmerComponentView"
      }
    }
  },
  "devDependencies": {
    "@react-native/babel-preset": "^0.88.1",
    "@react-native/jest-preset": "^0.88.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.3.0",
    "jest": "^29.7.0",
    "react": "^19.3.1",
    "react-native": "^0.88.1",
    "react-test-renderer": "^19.3.1",
    "typescript": "^5.9.3"
  }
}
